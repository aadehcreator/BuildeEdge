generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER ────────────────────────────────────────────────────────────────────
model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  email         String?        @unique
  name          String?
  passwordHash  String?
  avatar        String?
  isVerified    Boolean        @default(false)
  role          Role           @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wallet        Wallet?
  vendorProfile VendorProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── VENDOR PROFILE ──────────────────────────────────────────────────────────
model VendorProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  businessName  String
  businessType  String // "Manufacturer" | "Distributor" | "Retailer" | "Wholesaler"
  gstin         String?        @unique
  pan           String?
  address       String
  city          String
  pincode       String
  phone         String
  email         String
  bankName      String?
  accountNumber String?
  ifsc          String?
  status        VendorStatus   @default(PENDING)
  commissionPct Float          @default(10.0) // Admin takes X% commission
  totalSales    Float          @default(0)
  totalOrders   Int            @default(0)
  rating        Float          @default(0)
  logo          String?
  description   String?
  isActive      Boolean        @default(false) // true after admin approval
  products      Product[]
  vendorOrders  VendorOrder[]
  payouts       VendorPayout[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── VENDOR ORDER (vendor ka portion of main order) ──────────────────────────
model VendorOrder {
  id            String            @id @default(cuid())
  vendorId      String
  vendor        VendorProfile     @relation(fields: [vendorId], references: [id])
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  items         OrderItem[]
  subtotal      Float
  commission    Float // Admin commission amount
  vendorEarning Float // vendorEarning = subtotal - commission
  status        VendorOrderStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ─── VENDOR PAYOUT ────────────────────────────────────────────────────────────
model VendorPayout {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id])
  amount    Float
  status    PayoutStatus  @default(PENDING)
  utr       String? // bank transfer reference
  note      String?
  createdAt DateTime      @default(now())
}

// ─── ADDRESS ─────────────────────────────────────────────────────────────────
model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  line1     String
  line2     String?
  pincode   String
  city      String
  lat       Float?
  lng       Float?
  isDefault Boolean @default(false)
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  image     String
  is_active Boolean    @default(false)
  parent_id String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────
model Product {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id])
  vendorId      String?
  vendor        VendorProfile?    @relation(fields: [vendorId], references: [id])
  sku           String            @unique
  base_price    Decimal           @db.Decimal(12, 2)
  unit_type     UnitType
  pricing_tiers BulkPricingTier[]
  order_items   OrderItem[]
  cartItems     CartItem[]
  images        String[]
  stock         Int               @default(0)
  isFeatured    Boolean           @default(false)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
}

model BulkPricingTier {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  threshold        Decimal @db.Decimal(12, 2)
  discounted_price Decimal @db.Decimal(12, 2)
}

// ─── ORDER ───────────────────────────────────────────────────────────────────
model Order {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  items            OrderItem[]
  vendorOrders     VendorOrder[]
  total            Decimal       @db.Decimal(12, 2)
  deliveryType     DeliveryType
  siteLocationLat  Decimal       @db.Decimal(9, 6)
  siteLocationLong Decimal       @db.Decimal(9, 6)
  status           OrderStatus   @default(PLACED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  vendorOrderId String?
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  quantity      Decimal      @db.Decimal(12, 2)
  priceAtOrder  Decimal      @db.Decimal(12, 2)
}

enum DeliveryType {
  EXPRESS_60_MIN
  SCHEDULED_DUMP
}

enum UnitType {
  BAG
  TON
  BRASS
  PIECE
  CUBIC_FEET
}

// ─── WALLET ──────────────────────────────────────────────────────────────────
model Wallet {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  balance      Float      @default(0)
  transactions WalletTx[]
}

model WalletTx {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  amount    Float
  type      String
  note      String?
  orderId   String?
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

// ─── BANNER ──────────────────────────────────────────────────────────────────
model Banner {
  id        String  @id @default(cuid())
  image     String
  link      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  title     String?
  subtitle  String?
}

// ─── NEWSLETTER ──────────────────────────────────────────────────────────────
model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  DELIVERY
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VendorStatus {
  PENDING // Registration submit, admin review baaki
  APPROVED // Admin ne approve kiya
  REJECTED // Admin ne reject kiya
  SUSPENDED // Temporarily band
}

enum VendorOrderStatus {
  PENDING
  ACCEPTED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StockLogType {
  STOCK_IN // Purchase/Restock
  STOCK_OUT // Sale
  ADJUSTMENT // Manual correction
  RETURN // Customer return
  DAMAGE // Damaged goods write-off
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}
